<UserControl x:Class="HVACrate2.App.Controls.VideoPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Border Background="Black" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <MediaElement x:Name="Player" Stretch="Uniform"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" Visibility="Collapsed" />

            <TextBlock x:Name="LoadingText" Text="Loading video..." Foreground="#AAAAAA" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <TextBlock x:Name="MissingText" Foreground="#AAAAAA" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="20" Visibility="Collapsed" />

            <StackPanel x:Name="Controls" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,12" Visibility="Collapsed">
                <Button x:Name="PlayPauseButton" Content="Play" Width="70" Padding="0,6"
                        Click="OnPlayPauseClick" Margin="0,0,8,0"
                        Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button x:Name="RestartButton" Content="Restart" Width="70" Padding="0,6"
                        Click="OnRestartClick"
                        Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
