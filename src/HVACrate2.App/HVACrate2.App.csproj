    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HVACrate2</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
