<Page x:Class="HVACrate2.App.Heating.HeatingResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Floor Heating — Results"
      Background="{DynamicResource PageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="{DynamicResource Str_Back}" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6" FontSize="13"
                    HorizontalAlignment="Left" Click="OnBackClick" />
            <TextBlock x:Name="TitleText" Text="Results" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding FloorLabel}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Rooms}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="All"
                                      HeadersVisibility="Column"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      RowBackground="{DynamicResource CardBackgroundBrush}"
                                      AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                      BorderThickness="1"
                                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                      VerticalGridLinesBrush="{DynamicResource CardBorderBrush}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Помещение" Binding="{Binding RoomLabel}" Width="120" />
                                    <DataGridTextColumn Header="Qпт (W)" Binding="{Binding QptText}" Width="90" />
                                    <DataGridTextColumn Header="r пд" Binding="{Binding RPdText}" Width="90" />
                                    <DataGridTextColumn Header="Qc (W)" Binding="{Binding QcText}" Width="90" />
                                    <DataGridTextColumn Header="m (kg/h)" Binding="{Binding MText}" Width="90" />
                                    <DataGridTextColumn Header="Qдол (W)" Binding="{Binding QdolText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
