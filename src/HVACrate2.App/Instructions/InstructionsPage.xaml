<Page x:Class="HVACrate2.App.Instructions.InstructionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:HVACrate2.App.Instructions"
      mc:Ignorable="d"
      Title="Instructions"
      Background="{DynamicResource PageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="{DynamicResource Str_Back}" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6" FontSize="13"
                    HorizontalAlignment="Left" Click="OnBackClick" />
            <TextBlock Text="{DynamicResource Str_Start_Instructions}" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center">

                <TextBlock Text="{DynamicResource Str_Instr_Heading1}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <controls:VideoPlayerControl x:Name="Video1" Height="380" Margin="0,0,0,16" />

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_1}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_2}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Str_Instr_Step1_3a}" /><Run Text="{DynamicResource Str_Instr_Mandatory}" FontWeight="SemiBold" /><Run Text="." />
                        </TextBlock>
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_4}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_5}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_6}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_7}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step1_8}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Str_Instr_Step1_9a}" /><Run Text="{DynamicResource Str_Instr_Mandatory}" FontWeight="SemiBold" /><Run Text="." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Str_Instr_Heading2}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <controls:VideoPlayerControl x:Name="Video2" Height="380" Margin="0,0,0,16" />

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Instr_Step2_1}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step2_2}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step2_3}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step2_4}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Str_Instr_Step2_5}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
