<Page x:Class="HVACrate2.App.Pages.PreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:HVACrate2.App.Controls"
      mc:Ignorable="d"
      Title="Preview"
      Background="{DynamicResource PageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="&#8592; Back" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6" FontSize="13"
                    HorizontalAlignment="Left" Click="OnBackClick" />
            <TextBlock Text="Review before writing Excel" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FloorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:FloorPreviewControl Grid.Column="0"
                                    Result="{Binding Result}" NorthDeg="{Binding NorthDeg}"
                                    Margin="0,0,20,0" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FloorNumber, StringFormat='Floor {0}'}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,10" />

                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Area" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding AreaText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Volume" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding VolumeText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Perimeter" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding PerimeterText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Corners (n)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CornersText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="Wall lengths by direction" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding WallLines}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,16,0" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>

                                    <TextBlock Text="Windows / doors (width×height — count by direction)" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding OpeningLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,10"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ConfirmButton" Content="Confirm &amp; Write Excel" Style="{StaticResource NavButtonStyle}"
                        Padding="20,12" Click="OnConfirmClick" Margin="0,0,12,0" />
                <controls:LoadingSpinner x:Name="ConfirmSpinner" VerticalAlignment="Center"
                                          Margin="0,0,12,0" Visibility="Collapsed" />
                <Button x:Name="DownloadButton" Content="Download filled Excel" Style="{StaticResource NavButtonStyle}"
                        Padding="20,12" Click="OnDownloadClick" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
