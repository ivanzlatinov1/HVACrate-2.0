<Page x:Class="HVACrate2.App.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="HVACrate"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <TextBlock Text="HVACrate"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Automated thermal-performance data extraction from DXF drawings"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,10,0,50" />

            <Button Content="Start"
                    Style="{StaticResource NavButtonStyle}"
                    Click="OnStartClick"
                    Margin="0,0,0,16" />

            <Button Content="Instructions"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnInstructionsClick" />
        </StackPanel>
    </Grid>
</Page>
