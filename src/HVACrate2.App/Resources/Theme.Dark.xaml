<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="AccentBrush" Color="#46B37D" />
    <Color x:Key="AccentGlowColor">#5CE0A4</Color>
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#F2F3F1" />
    <sys:Double x:Key="TitleShadowDepth">0</sys:Double>
    <sys:Double x:Key="TitleShadowOpacity">0.85</sys:Double>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#57C98F" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#24312A" />
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B2A20" Offset="0" />
        <GradientStop Color="#151A1E" Offset="0.5" />
        <GradientStop Color="#1B1030" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F2224" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#33373A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7ACA8" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B5D" />
</ResourceDictionary>
