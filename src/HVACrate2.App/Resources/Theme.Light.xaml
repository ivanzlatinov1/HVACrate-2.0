<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6F4F" />
    <Color x:Key="AccentGlowColor">#2F6F4F</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D8A64" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#E9F2EC" />
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DFF6E8" Offset="0" />
        <GradientStop Color="#FDF6E3" Offset="0.5" />
        <GradientStop Color="#E4F1FB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DDDEDD" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1F1E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B615E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
</ResourceDictionary>
